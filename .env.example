# Copy to .env and fill real values. Never commit .env or real keys.
# This project stores no keys in code; all config here is environment/optional.

# Redshift Query API (sibling redshift-api service) — powers the loan-tape
# dropdown in the Run tab. The API key must match redshift-api/.env's API_KEY.
# REDSHIFT_API_URL=http://127.0.0.1:8001
# REDSHIFT_API_KEY=<key from redshift-api/.env>

# Optional: where the run log lives (default: ./verifications.log.jsonl)
# VERIFICATIONS_LOG=verifications.log.jsonl

# Optional: where reports/artifacts are written (default: ./out)
# VERIFICATIONS_OUT=out

# Optional LLM provider key, used only by the interpretive (D3) steps — the
# "Ask (AI)" tab's NL querying (Output 8). The deterministic engine never
# calls these. Set config.yaml's llm.provider to match: "openai" needs
# OPENAI_API_KEY, "anthropic" needs ANTHROPIC_API_KEY, "deepinfra" (e.g. for
# DeepSeek models — deepinfra.com/deepseek) needs DEEPINFRA_API_KEY. Leave
# llm.provider empty to keep the app fully rules-only (no outbound LLM calls).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPINFRA_API_KEY=

# Google Sheets export (phase0_foundations/gsheet_export.py) — the "Download
# as Google Sheet" button under the loan-tape section of the Run tab.
# Sheets are created under YOUR OWN Google account (not a service account,
# which has zero Drive storage quota and can't write outside a Shared
# Drive). One-time setup:
#   1. Create an OAuth client (Google Cloud Console -> APIs & Services ->
#      Credentials -> Create Credentials -> OAuth client ID -> Desktop app),
#      download its JSON, and set GOOGLE_OAUTH_CLIENT_JSON to that path.
#   2. Run `python scripts/google_oauth_setup.py` once -- it opens a browser
#      for you to sign in, then saves a refreshable token to
#      GOOGLE_OAUTH_TOKEN_JSON. The app reads and refreshes that silently at
#      runtime; no browser needed again.
# GOOGLE_OAUTH_CLIENT_JSON=path/to/your-oauth-client.json
# GOOGLE_OAUTH_TOKEN_JSON=google_oauth_token.json

# Optional: a specific Drive folder (in your own Drive) new Sheets land in.
# Leave unset to create them in your Drive root ("My Drive").
# DRIVE_FOLDER_ID=

# SOP 1 statement drop-folder (phase0_foundations/drive_inbox.py) — reads bank/
# wallet statements humans place in a Google Drive folder, so the watcher can
# reconcile tape figures against real inflows/outflows and retain the raw files
# as the audit trail. Uses a SEPARATE read-only (drive.readonly) OAuth token from
# the Sheets token above (drive.file only sees files the app created, so it
# cannot list a folder another party uploads to). One-time setup:
#   1. Set GOOGLE_OAUTH_CLIENT_JSON (the same OAuth client works).
#   2. Run `python scripts/google_oauth_setup.py --feature inbox` once — opens a browser,
#      grants drive.readonly, saves a refreshable token to
#      GOOGLE_OAUTH_INBOX_TOKEN_JSON. The watcher refreshes it silently. Without
#      this token, statement fetching is skipped and the run is tape-only.
# GOOGLE_OAUTH_INBOX_TOKEN_JSON=google_oauth_inbox_token.json

# SOP 1 report email delivery (phase0_foundations/emailer.py) â€” emails the
# watcher's working paper (.md + .json) after every change-triggered run via the
# Gmail API (OAuth). No app password needed, so it works on corporate Google
# Workspace accounts where the admin has disabled SMTP app passwords. One-time
# setup (same OAuth client as the Drive features):
#   python scripts/google_oauth_setup.py --feature gmail
# (requires the Gmail API enabled on the Cloud project for that client). Enable
# delivery in config.yaml under sop1.watcher.email (enabled, from_addr,
# to_addrs). Keep this disabled until a real authenticated send is verified.
# GOOGLE_OAUTH_GMAIL_TOKEN_JSON=google_oauth_gmail_token.json

# PDF parsing fallback: only needed if you want OCR on scanned statements
# (phase1_ingestion_parsing/ocr.py). Leave unset to use `tesseract` from PATH,
# or the common Windows install paths it checks automatically. Requires the
# `tesseract-ocr` binary itself, not just the pip packages in requirements.txt.
# TESSERACT_CMD=
