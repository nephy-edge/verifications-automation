# Copy to .env and fill real values. Never commit .env or real keys.
# This project stores no keys in code; all config here is environment/optional.

# Redshift Query API (sibling redshift-api service) — powers the loan-tape
# dropdown in the Run tab. The API key must match redshift-api/.env's API_KEY.
# REDSHIFT_API_URL=http://127.0.0.1:8001
# REDSHIFT_API_KEY=<key from redshift-api/.env>

# Optional: where the run log lives (default: ./verifications.log.jsonl)
# VERIFICATIONS_LOG=verifications.log.jsonl

# Optional: where reports/artifacts are written (default: ./out)
# VERIFICATIONS_OUT=out

# Optional LLM provider keys, used only by the interpretive (D3) steps.
# The deterministic engine never calls these.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# PDF parsing fallback: only needed if you want OCR on scanned statements
# (phase1_ingestion_parsing/ocr.py). Leave unset to use `tesseract` from PATH,
# or the common Windows install paths it checks automatically. Requires the
# `tesseract-ocr` binary itself, not just the pip packages in requirements.txt.
# TESSERACT_CMD=
